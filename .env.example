# MedSync environment configuration — copy to `.env` and fill in.
# `.env` holds real credentials and must never be committed.

# --- Core -------------------------------------------------------------------
# Generate one with:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
SECRET_KEY=
DEBUG=True
# Comma-separated. Replace '*' with your real hostnames before deploying.
ALLOWED_HOSTS=*

# --- Email backend ----------------------------------------------------------
# Leave EMAIL_BACKEND unset for local development: verification, password-reset and
# appointment emails then print to the runserver terminal, and the whole flow is
# testable with no account anywhere. Uncomment to send over SMTP.
#EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend

# --- Brevo SMTP — the configured default -------------------------------------
# Real delivery, and it verifies a single *sender address* rather than requiring a
# domain you own — so this works from a personal address.
# Credentials: Brevo -> SMTP & API -> SMTP. EMAIL_HOST_PASSWORD is the SMTP *key*,
# not your Brevo account password, and EMAIL_HOST_USER is the SMTP login shown on
# that page (not necessarily your account email).
EMAIL_HOST=smtp-relay.brevo.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=

# Must be a sender Brevo has verified for your account.
DEFAULT_FROM_EMAIL=MedSync <no-reply@yourdomain.com>
SUPPORT_EMAIL=support@yourdomain.com

# Note: Brevo's free tier has a daily send cap. When iterating on forms rather than
# on email, comment out EMAIL_BACKEND above to print to the terminal instead.

# --- Other providers ---------------------------------------------------------
# Same variables, different values — no code changes needed.
#
# Mailtrap, Email Sending (live) — real delivery, but requires a sending domain you
# own and verified under Sending Domains; a @gmail.com sender is rejected:
#   EMAIL_HOST=live.smtp.mailtrap.io
#   EMAIL_PORT=587
#   EMAIL_HOST_USER=api
#   EMAIL_HOST_PASSWORD=<your Mailtrap API token>
#   DEFAULT_FROM_EMAIL=MedSync <no-reply@yourdomain.com>
#   Logs: https://mailtrap.io/sending/email_logs
#
# Mailtrap, Email Testing (sandbox) — captures mail, delivers to nobody. No domain
# needed. Credentials are per-inbox, from Email Testing -> inbox -> Integrations:
#   EMAIL_HOST=sandbox.smtp.mailtrap.io
#   EMAIL_PORT=2525
#   EMAIL_HOST_USER=<inbox username>
#   EMAIL_HOST_PASSWORD=<inbox password>
#
# Resend:
#   EMAIL_HOST=smtp.resend.com
#   EMAIL_PORT=587
#   EMAIL_HOST_USER=resend
#   EMAIL_HOST_PASSWORD=<your Resend API key>
#
# Gmail (development only — use an App Password, not your account password,
# and don't build production email on a personal mailbox):
#   EMAIL_HOST=smtp.gmail.com
#   EMAIL_PORT=587
#   EMAIL_HOST_USER=you@gmail.com
#   EMAIL_HOST_PASSWORD=<16-character App Password>

# --- Other providers --------------------------------------------------------
# Same variables, different values — no code changes needed.
#
# Brevo (delivers to real inboxes; sender address or domain must be verified):
#   EMAIL_HOST=smtp-relay.brevo.com
#   EMAIL_PORT=587
#   EMAIL_HOST_USER=<SMTP login from Brevo -> SMTP & API -> SMTP>
#   EMAIL_HOST_PASSWORD=<your Brevo SMTP key, not your account password>
#
# Resend:
#   EMAIL_HOST=smtp.resend.com
#   EMAIL_PORT=587
#   EMAIL_HOST_USER=resend
#   EMAIL_HOST_PASSWORD=<your Resend API key>
#
# Gmail (development only — use an App Password, not your account password,
# and don't build production email on a personal mailbox):
#   EMAIL_HOST=smtp.gmail.com
#   EMAIL_PORT=587
#   EMAIL_HOST_USER=you@gmail.com
#   EMAIL_HOST_PASSWORD=<16-character App Password>
